# Copy to secrets.yaml (next to your device YAML) and fill in your own values.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
ota_password: "choose-an-ota-password"
# Generate one at https://esphome.io/components/api/#configuration-variables
api_encryption_key: "REPLACE_WITH_YOUR_BASE64_KEY"
